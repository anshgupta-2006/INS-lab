#include <iostream>
#include <string>
#include <cctype>

// Function to encrypt text using Caesar Cipher
std::string encryptCaesar(std::string text, int shift) {
    std::string result = "";
    
    // Normalize shift to be within 0-25 range to handle shifts > 26 and negative shifts
    shift = (shift % 26 + 26) % 26;

    for (char c : text) {
        if (std::isupper(c)) {
            // Apply shift for uppercase characters (ASCII 65-90)
            result += char(int(c - 'A' + shift) % 26 + 'A');
        } else if (std::islower(c)) {
            // Apply shift for lowercase characters (ASCII 97-122)
            result += char(int(c - 'a' + shift) % 26 + 'a');
        } else {
            // Leave non-alphabetic characters unchanged
            result += c;
        }
    }
    return result;
}

// Function to decrypt text using Caesar Cipher
std::string decryptCaesar(std::string text, int shift) {
    // Decryption is just encryption with the negative shift
    return encryptCaesar(text, -shift);
}

int main() {
    std::string text;
    int shift;

    std::cout << "Enter the message: ";
    std::getline(std::cin, text);

    std::cout << "Enter the shift key (e.g., 3): ";
    std::cin >> shift;

    std::string encrypted = encryptCaesar(text, shift);
    std::string decrypted = decryptCaesar(encrypted, shift);

    std::cout << "\n--- Caesar Cipher Results ---" << std::endl;
    std::cout << "Original Text  : " << text << std::endl;
    std::cout << "Encrypted Text : " << encrypted << std::endl;
    std::cout << "Decrypted Text : " << decrypted << std::endl;

    return 0;
}